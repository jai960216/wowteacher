# ============================================
# 클라이언트 (VITE_ 접두사 — 번들에 포함됨, 비밀 아님)
# ============================================
VITE_WARCRAFTLOGS_CLIENT_ID=

# 서버 공유 캐시 사용 여부 ("true"면 /api/* 경유)
VITE_USE_SHARED_CACHE=false

# 클라 캐시 스키마 버전 — 패치·스키마 변경 시 bump해서 LRU·LM 즉시 무효화
# (서버 측 CACHE_VERSION과는 별개. 시즌 전환 시 양쪽 모두 bump 권장.)
VITE_CACHE_VERSION=1

# ============================================
# 서버 전용 (서버리스 함수에서만 사용 — 비밀)
# ============================================
# Supabase 서버 접근 (서비스 롤 키 — RLS 우회, 외부 노출 절대 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (PKCE 클라이언트라 CLIENT_SECRET 없음. 서버는 유저 토큰을 proxy해서 WCL 호출)

# 관리자 퍼지 엔드포인트 보호 (임의 긴 랜덤 문자열 권장)
ADMIN_SECRET=

# 캐시 스키마 버전 — 패치·스키마 변경 시 bump해서 전체 무효화
CACHE_VERSION=1
